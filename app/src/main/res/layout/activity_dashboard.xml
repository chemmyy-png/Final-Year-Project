<?xml version="1.0" encoding="utf-8"?>
<!--
    Same visual design as before. Three changes:
      1. The three stat numbers now have IDs so they can be filled from a scan.
      2. The filter tabs have IDs and are clickable.
      3. The two hardcoded network cards are replaced by a RecyclerView that
         inflates item_network_card.xml once per detected access point.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/logoIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/icon_rounded_box"
            android:contentDescription="@string/cd_app_logo"
            android:padding="12dp"
            app:srcCompat="@drawable/icon_transparent"
            app:tint="@color/white_text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_18pt_bold"
                android:text="@string/wishield"
                android:textColor="@color/white_text"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_18pt_medium"
                android:text="@string/security_monitor"
                android:textColor="@color/secondary_white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Summary Statistics Section -->
    <LinearLayout
        android:id="@+id/statsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/headerSection">

        <!-- Total Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/card_background_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/cd_total_icon"
                app:srcCompat="@drawable/transparent_1"
                app:tint="@color/status_blue" />

            <TextView
                android:id="@+id/statTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_18pt_bold"
                android:text="0"
                android:textColor="@color/white_text"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_18pt_medium"
                android:text="@string/total_label"
                android:textColor="@color/secondary_white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Safe Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/card_background_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/cd_safe_icon"
                app:srcCompat="@drawable/transparent_3"
                app:tint="@color/status_green" />

            <TextView
                android:id="@+id/statSafe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_18pt_bold"
                android:text="0"
                android:textColor="@color/status_green"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_18pt_medium"
                android:text="@string/safe_label"
                android:textColor="@color/secondary_white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Flagged Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/card_background_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/cd_flagged_icon"
                app:srcCompat="@drawable/transparent_2"
                app:tint="@color/status_red" />

            <TextView
                android:id="@+id/statFlagged"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_18pt_bold"
                android:text="0"
                android:textColor="@color/status_red"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_18pt_medium"
                android:text="@string/revoked_label"
                android:textColor="@color/secondary_white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Rescan Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRescan"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/primary_blue"
        android:fontFamily="@font/inter_18pt_bold"
        android:text="@string/rescan_network"
        android:textAllCaps="false"
        android:textColor="@color/white_text"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/stat_notify_sync"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/white_text"
        app:layout_constraintTop_toBottomOf="@id/statsSection" />

    <!-- Filter Tabs -->
    <LinearLayout
        android:id="@+id/filterTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/btnRescan">

        <TextView
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/rescan_button_background"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_18pt_bold"
            android:gravity="center"
            android:text="@string/filter_all"
            android:textColor="@color/white_text" />

        <TextView
            android:id="@+id/tabSafe"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/filter_tab_background"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_18pt_bold"
            android:gravity="center"
            android:text="@string/filter_safe"
            android:textColor="@color/secondary_white" />

        <TextView
            android:id="@+id/tabFlagged"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/filter_tab_background"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_18pt_bold"
            android:gravity="center"
            android:text="@string/filter_revoked"
            android:textColor="@color/secondary_white" />
    </LinearLayout>

    <!-- Results -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/networkList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filterTabs"
        tools:itemCount="3"
        tools:listitem="@layout/item_network_card" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/inter_18pt_medium"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="@string/empty_no_scan"
        android:textAlignment="center"
        android:textColor="@color/secondary_white"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filterTabs" />

</androidx.constraintlayout.widget.ConstraintLayout>