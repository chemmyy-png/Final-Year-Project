<?xml version="1.0" encoding="utf-8"?>
<!--
    One scanned access point. This mirrors the hardcoded cards that were in
    activity_dashboard.xml, with IDs added so the adapter can fill it in.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/card_background_rounded"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/networkIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/filter_tab_background"
            android:contentDescription="@string/cd_network_icon"
            android:padding="8dp"
            app:srcCompat="@drawable/transparent_1"
            app:tint="@color/status_blue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/networkIcon"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textSsid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_18pt_bold"
                    android:maxLines="1"
                    android:textColor="@color/white_text"
                    android:textSize="18sp"
                    tools:text="HomeNetwork" />

                <TextView
                    android:id="@+id/textBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/badge_safe_background"
                    android:fontFamily="@font/inter_18pt_bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/status_green"
                    android:textSize="10sp"
                    tools:text="SAFE" />
            </LinearLayout>

            <TextView
                android:id="@+id/textBssid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_18pt_medium"
                android:textColor="@color/secondary_white"
                android:textSize="12sp"
                tools:text="00:1A:2B:3C:4D:5E" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_security_label"
                android:textColor="@color/secondary_white"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/textSecurity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_18pt_bold"
                android:textColor="@color/white_text"
                android:textSize="14sp"
                tools:text="WPA3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_vendor_label"
                android:textColor="@color/secondary_white"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/textVendor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_18pt_bold"
                android:maxLines="1"
                android:textColor="@color/white_text"
                android:textSize="14sp"
                tools:text="TP-Link" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_signal_label"
                android:textColor="@color/secondary_white"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/textSignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_18pt_bold"
                android:textColor="@color/white_text"
                android:textSize="14sp"
                tools:text="-52 dBm" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCardAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/primary_blue"
        android:textAllCaps="false"
        android:textColor="@color/white_text"
        app:cornerRadius="12dp"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="16dp"
        app:iconTint="@color/white_text"
        tools:text="Connect" />

</LinearLayout>